# Production template for Mejeck IcePlant on Vercel + Supabase.
#
# On Vercel there is no .env file: set each of these in
# Project > Settings > Environment Variables (Production). Redeploy after
# changing any of them — they are read at request time, and the ones marked
# "build time" are also baked into the JS bundle.
#
# Values marked CHANGE_ME must be filled in. Never commit the filled-in copy.

APP_NAME="Mejeck IcePlant"
APP_ENV=production
# Generate once locally: php artisan key:generate --show
# Paste the whole value, including the "base64:" prefix.
APP_KEY=base64:OSWDBLrzdi7gw316SxkkVke9oE9rWnxe/FhMKbL8b68=
APP_DEBUG=false
# Philippine time. Drives the daily summary, GCash expiry and every timestamp.
APP_TIMEZONE=Asia/Manila
# Your real domain, with https. Forces https links/assets (AppServiceProvider).
# If unset, api/index.php falls back to the .vercel.app production domain.
APP_URL=https://CHANGE_ME.vercel.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12

# api/index.php forces LOG_CHANNEL=stderr (the filesystem is read-only, so a
# file log would 500 every request). Logs appear under the deployment's Logs tab.
LOG_LEVEL=error

# --- Supabase Postgres ---------------------------------------------------
# Supabase dashboard > Connect > Session pooler ("Shared pooler", port 5432).
# Use the SESSION pooler, not the transaction pooler (6543): that one can't do
# prepared statements, and emulating them breaks Laravel's boolean bindings.
# The direct db.<ref>.supabase.co host is IPv6-only unless you buy the IPv4
# add-on, which Vercel cannot reach.
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-northeast-2.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
# Note the dot: "postgres.<your-project-ref>"
DB_USERNAME=postgres.bepgrfpztsidkeyzgvic
DB_PASSWORD=CHANGE_ME_database_password
DB_SSLMODE=require

# Postgres-backed, so they survive between serverless invocations.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Requires HTTPS, which Vercel always provides.
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
# No queue worker can run on Vercel: jobs must execute in-request.
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log

# --- Supabase Storage (uploads: payment proofs, delivery photos, evidence) ---
# Vercel's filesystem is read-only, so uploads cannot go to storage/app/public.
# Setting SUPABASE_URL switches the "public" disk to Supabase Storage.
# Create a bucket and mark it PUBLIC, then take the S3 keys from
# Supabase > Project Settings > Storage > S3 access keys.
SUPABASE_URL=https://bepgrfpztsidkeyzgvic.supabase.co
SUPABASE_STORAGE_BUCKET=uploads
#SUPABASE_S3_KEY=CHANGE_ME_access_key_id
#SUPABASE_S3_SECRET=CHANGE_ME_secret_access_key
# Must match the project's region (Supabase > Settings > General), e.g. ap-southeast-1.
SUPABASE_S3_REGION=ap-northeast-2

# --- Scheduled job -------------------------------------------------------
# Vercel Cron calls /api/cron/gcash-cancel-expired daily (see vercel.json) and
# authenticates with this value. Generate one: php -r "echo bin2hex(random_bytes(32));"
CRON_SECRET=CHANGE_ME_random_string

# --- Mail ----------------------------------------------------------------
# Gmail needs an App Password (Google Account > Security > 2-Step Verification
# > App passwords), not the normal account password.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME@gmail.com
MAIL_PASSWORD=CHANGE_ME_app_password
MAIL_ENCRYPTION=tls
MAIL_TIMEOUT=30
MAIL_FROM_ADDRESS="noreply@mejeckiceplant.com"
MAIL_FROM_NAME="${APP_NAME}"
# Inbox that receives the public Contact form.
MAIL_CONTACT_ADDRESS=CHANGE_ME@gmail.com

# --- reCAPTCHA (build time) ----------------------------------------------
# v2 checkbox keys. Add the production domain under the key's "Domains" in the
# Google reCAPTCHA admin console. Leave both blank to disable the check.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Only needed while seeding the first SuperAdmin; remove it afterwards.
SUPERADMIN_PASSWORD=

# Build time: baked into the JS bundle, so a change needs a redeploy.
VITE_APP_NAME="${APP_NAME}"
VITE_RECAPTCHA_SITE_KEY="${RECAPTCHA_SITE_KEY}"
