# Production template for Mejeck IcePlant.
# Copy to .env on the live server and fill in every blank / CHANGE_ME value.
# Never commit the filled-in copy.

APP_NAME="Mejeck IcePlant"
APP_ENV=production
# Generate on the server: php artisan key:generate --force
APP_KEY=
APP_DEBUG=false
# Philippine time. Set this BEFORE real orders exist: it changes how stored
# timestamps are read, and drives the daily summary and GCash expiry.
APP_TIMEZONE=Asia/Manila
APP_URL=https://CHANGE_ME_your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# One file per day, old ones auto-deleted (LOG_DAILY_DAYS, default 14).
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Use a dedicated MySQL user with rights on this database only — not root.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=capstone
DB_USERNAME=CHANGE_ME_db_user
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Requires HTTPS. Cookies are only sent over https when this is true.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# "sync" sends the forgot-password OTP email immediately, so no separate
# queue worker process is needed. Switch to "database" only if you also run
# `php artisan queue:work` as a permanent service.
QUEUE_CONNECTION=sync
CACHE_STORE=database
CACHE_PREFIX=

# Gmail SMTP needs an App Password (Google Account > Security > 2-Step
# Verification > App passwords), not the normal account password.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME@gmail.com
MAIL_PASSWORD=CHANGE_ME_app_password
MAIL_ENCRYPTION=tls
MAIL_TIMEOUT=30
MAIL_FROM_ADDRESS="noreply@mejeckiceplant.com"
MAIL_FROM_NAME="${APP_NAME}"
# Inbox that receives the public Contact form.
MAIL_CONTACT_ADDRESS=CHANGE_ME@gmail.com

# reCAPTCHA v2 checkbox keys — the production domain must be listed under
# the key's "Domains" in the Google reCAPTCHA admin console. The site key is
# baked in at build time, so re-run `npm run build` after changing it.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Only used when seeding (php artisan db:seed --class=CreateLoggedInUserSeeder).
# Use a strong, NEW password for production, then remove this line.
SUPERADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
VITE_RECAPTCHA_SITE_KEY="${RECAPTCHA_SITE_KEY}"
