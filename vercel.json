{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "echo Nothing to build here: composer install and the composer vercel script build everything.",
  "regions": ["sin1"],
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4",
      "maxDuration": 60,
      "excludeFiles": "{node_modules/**,tests/**,resources/js/**,resources/css/**,storage/logs/**,backup/**,.git/**,.github/**,vercel.json,.vercelignore}"
    }
  },
  "routes": [
    { "src": "/(.*)", "dest": "/api/index.php" }
  ],
  "crons": [
    { "path": "/api/cron/gcash-cancel-expired", "schedule": "0 16 * * *" }
  ]
}
